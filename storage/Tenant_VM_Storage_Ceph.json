          "editorMode": "code",
          "expr": "max(ceph_rbd_image_provisioned_bytes{cluster_name=\"$cluster\",pool=\"$pool\",image=\"$image\"})",
          "legendFormat": "Provisioned",
          "range": true,
          "instant": false,
          "refId": "A"
