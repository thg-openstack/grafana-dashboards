  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OVS Geneve tunnel BFD state from bfd_discovery.py --prom (node_exporter textfile collector) on OpenStack network and compute nodes.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Metrics source (ansible-base-config#1052)",
      "type": "link",
      "icon": "doc",
      "url": "https://github.com/thg-openstack/ansible-base-config/issues/1052",
      "targetBlank": true,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "folder-network"
      ],
      "targetBlank": false,
      "title": "Browse Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "BFD tunnels not forwarding",
      "description": "BFD-enabled tunnels whose BFD session says the path is not forwarding right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ovs_tunnel_bfd_enabled{os_region=~\"$region\", instance=~\"$host\"} == 1 and on(os_region, instance, name, remote_ip) ovs_tunnel_bfd_forwarding{os_region=~\"$region\", instance=~\"$host\"} == 0) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tunnels flapping (10m)",
      "description": "Tunnels whose BFD session changed state in the last 10 minutes. The counter resets when ovs-vswitchd restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(increase(ovs_tunnel_bfd_flap_count_total{os_region=~\"$region\", instance=~\"$host\"}[10m]) > 0) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "BFD flaps (10m)",
      "description": "Total BFD state changes across the selected tunnels in the last 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(increase(ovs_tunnel_bfd_flap_count_total{os_region=~\"$region\", instance=~\"$host\"}[10m])) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hosts failing collection",
      "description": "bfd_discovery.py --prom could not read the tunnels: ovs-vsctl failed or did not answer within 20s (for example a hung ovs-vswitchd).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ovs_tunnel_scrape_success{os_region=~\"$region\", instance=~\"$host\"} == 0) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Hosts with stale data",
      "description": "ovs_tunnels.prom not rewritten for more than 2 minutes: the bfd-prom timer is not running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(time() - node_textfile_mtime_seconds{os_region=~\"$region\", instance=~\"$host\", file=~\".*ovs_tunnels.prom\"} > 120) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "BFD tunnels",
      "description": "BFD-enabled tunnels reported by the selected hosts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(ovs_tunnel_bfd_enabled{os_region=~\"$region\", instance=~\"$host\"} == 1) or vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1000000000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "BFD",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "BFD flaps per tunnel",
      "description": "BFD state changes per tunnel. Each flap is counted on both ends, so a flapping link shows up for both hosts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum by (os_region, instance, name, remote_ip) (increase(ovs_tunnel_bfd_flap_count_total{os_region=~\"$region\", instance=~\"$host\"}[$__rate_interval])) > 0) * on(os_region, remote_ip) group_left(remote_host) group by (os_region, remote_ip, remote_host) (label_replace(label_replace(ovs_tunnel_bfd_enabled{os_region=~\"$region\"}, \"remote_ip\", \"$1\", \"local_ip\", \"(.*)\"), \"remote_host\", \"$1\", \"instance\", \"(.*)\")) or on(os_region, instance, name, remote_ip) label_replace((sum by (os_region, instance, name, remote_ip) (increase(ovs_tunnel_bfd_flap_count_total{os_region=~\"$region\", instance=~\"$host\"}[$__rate_interval])) > 0), \"remote_host\", \"$1\", \"remote_ip\", \"(.*)\")",
          "refId": "A",
          "legendFormat": "{{instance}} -> {{remote_host}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "sum"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tunnels not forwarding, per host",
      "description": "Number of BFD tunnels on each host that were not forwarding when scraped (every 30s). Short flaps that recover between scrapes do not show here; see BFD flaps per tunnel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count by (os_region, instance) (ovs_tunnel_bfd_enabled{os_region=~\"$region\", instance=~\"$host\"} == 1 and on(os_region, instance, name, remote_ip) ovs_tunnel_bfd_forwarding{os_region=~\"$region\", instance=~\"$host\"} == 0)",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Collection health",
      "description": "Age of ovs_tunnels.prom per host. The timer rewrites it every 30s; above 120s the timer has stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (os_region, instance) (time() - node_textfile_mtime_seconds{os_region=~\"$region\", instance=~\"$host\", file=~\".*ovs_tunnels.prom\"})",
          "refId": "A",
          "legendFormat": "{{instance}} file age",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Tunnels",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "table",
      "title": "BFD tunnels",
      "description": "Current state of every BFD tunnel. Flaps are counted over the selected time range. Diagnostic is the reason for the last state change: \"Detect time expired\" means this host stopped receiving BFD packets from the remote; \"Neighbor down\" means the remote told it the session went down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(max by (os_region, instance, name, remote_ip) (ovs_tunnel_bfd_forwarding{os_region=~\"$region\", instance=~\"$host\"} and on(os_region, instance, name, remote_ip) ovs_tunnel_bfd_enabled{os_region=~\"$region\", instance=~\"$host\"} == 1)) * on(os_region, remote_ip) group_left(remote_host) group by (os_region, remote_ip, remote_host) (label_replace(label_replace(ovs_tunnel_bfd_enabled{os_region=~\"$region\"}, \"remote_ip\", \"$1\", \"local_ip\", \"(.*)\"), \"remote_host\", \"$1\", \"instance\", \"(.*)\")) or on(os_region, instance, name, remote_ip) label_replace((max by (os_region, instance, name, remote_ip) (ovs_tunnel_bfd_forwarding{os_region=~\"$region\", instance=~\"$host\"} and on(os_region, instance, name, remote_ip) ovs_tunnel_bfd_enabled{os_region=~\"$region\", instance=~\"$host\"} == 1)), \"remote_host\", \"$1\", \"remote_ip\", \"(.*)\")",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(max by (os_region, instance, name, remote_ip, state) (ovs_tunnel_bfd_state{os_region=~\"$region\", instance=~\"$host\"} == 1)) * on(os_region, remote_ip) group_left(remote_host) group by (os_region, remote_ip, remote_host) (label_replace(label_replace(ovs_tunnel_bfd_enabled{os_region=~\"$region\"}, \"remote_ip\", \"$1\", \"local_ip\", \"(.*)\"), \"remote_host\", \"$1\", \"instance\", \"(.*)\")) or on(os_region, instance, name, remote_ip) label_replace((max by (os_region, instance, name, remote_ip, state) (ovs_tunnel_bfd_state{os_region=~\"$region\", instance=~\"$host\"} == 1)), \"remote_host\", \"$1\", \"remote_ip\", \"(.*)\")",
          "refId": "B",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(max by (os_region, instance, name, remote_ip, remote_state) (label_replace(ovs_tunnel_bfd_remote_state{os_region=~\"$region\", instance=~\"$host\"} == 1, \"remote_state\", \"$1\", \"state\", \"(.*)\"))) * on(os_region, remote_ip) group_left(remote_host) group by (os_region, remote_ip, remote_host) (label_replace(label_replace(ovs_tunnel_bfd_enabled{os_region=~\"$region\"}, \"remote_ip\", \"$1\", \"local_ip\", \"(.*)\"), \"remote_host\", \"$1\", \"instance\", \"(.*)\")) or on(os_region, instance, name, remote_ip) label_replace((max by (os_region, instance, name, remote_ip, remote_state) (label_replace(ovs_tunnel_bfd_remote_state{os_region=~\"$region\", instance=~\"$host\"} == 1, \"remote_state\", \"$1\", \"state\", \"(.*)\"))), \"remote_host\", \"$1\", \"remote_ip\", \"(.*)\")",
          "refId": "C",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
