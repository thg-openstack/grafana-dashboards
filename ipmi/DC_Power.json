      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(node_ipmi_dcmi_power_consumption_watts{site=~\"(?i)^$site$\", rack=~\"$rack\"})",
          "legendFormat": "Servers",
          "range": true,
          "refId": "A"
